*-BEFUND.md
*-HANDOFF.md
*-PLAN.md
*-SYSTEM-PROMPT.txt
/AUDIT-*.md
/GOAL-*.md
/EXPERIMENT-*.md
/showcase/
/PROOF/
/proof/
/belege/
/notes/
/.wave/
# Build helpers for the Windows test machine
/a[0-9]*-build.ps1
/*-box-*.ps1
# Screenshots taken while checking a build
/.*.png
/*-proof.png
/*-beweis.png

# Keys and credentials never belong in this repository, whatever tool wrote
# them next to the sources.
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.pfx
*.keystore
*.jks
credentials*.json
service-account*.json

# The notes under mobile-docs/ are checked in on purpose: they are the record
# of the phone build, and several are named like the working notes above
# (INTEGRATION-306.md is one). Without this line a new note with such a name
# would be left out without a word. Must stay below the block above.
!/mobile-docs/**/*.md
