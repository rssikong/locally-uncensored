<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptives Icon ab Android 8. Vordergrund und Monochrom liegen als PNG in mipmap-*.
     Das Motiv bleibt innerhalb von 30 dp Radius, die Sicherheitszone erlaubt 33 dp.
     monochrome wird ab Android 13 fuer themed icons benutzt, aeltere Versionen ignorieren es. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
