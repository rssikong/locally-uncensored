{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "testbett",
  "version": "0.1.0",
  "identifier": "de.lu.harness.testbett",
  "build": {
    "frontendDist": "../statisch"
  },
  "app": {
    "windows": [{ "title": "testbett", "disableInputAccessoryView": true }],
    "security": { "csp": null },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "iOS": { "minimumSystemVersion": "17.0" }
  },
  "plugins": {
    "deep-link": { "mobile": [{ "scheme": ["luharness"], "appLink": false }] }
  }
}
